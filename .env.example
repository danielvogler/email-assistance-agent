# Local development only, against a throwaway test mailbox, never a real one.
# On Cloud Run these arrive as environment variables and EMAIL_PASSWORD is
# injected from Secret Manager; no .env exists there.

# Required: the mailbox address, and its Gmail app password (needs 2-Step
# Verification). Never the account password.
EMAIL_USER=
EMAIL_PASSWORD=

# IMAP server. Defaults: imap.gmail.com, 993, 30.
IMAP_HOST=
IMAP_PORT=
IMAP_TIMEOUT_SECONDS=

# Fallback when the server advertises no \Drafts special-use folder.
DRAFTS_FOLDER=

# Appended to every draft below a "-- " line. Use \n for new lines.
EMAIL_SIGNATURE=

# Read scope. Comma-separated labels (empty = all); days (empty = no limit).
READ_LABELS=
READ_MAX_AGE_DAYS=

# Host headers the MCP endpoint accepts. Default: localhost:*,127.0.0.1:*
ALLOWED_HOSTS=

# Defaults: 8080, INFO.
PORT=
LOG_LEVEL=
